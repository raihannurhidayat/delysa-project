# Delysa Florist — Web (TanStack Start) env example
# Salin ke .env untuk lokal: cp .env.example .env
# Production/Preview: set nilai yang sama via Vercel Dashboard → Project → Settings → Environment Variables.
# JANGAN commit file .env berisi nilai nyata.

# Public base URL API (dibundel ke browser via import.meta.env — hanya untuk nilai publik/mock).
VITE_API_URL=http://localhost:8000/api

# Server-only (tanpa prefix VITE_, dibaca via process.env di server functions/loaders).
# Set di Vercel dashboard per environment (Production, Preview, Development), min 32 char random.
# BETTER_AUTH_SECRET=[set-via-vercel-dashboard]

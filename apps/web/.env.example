# Delysa Florist — Web (TanStack Start) env example
# Salin ke .env untuk lokal: cp .env.example .env
# Production/Preview: set nilai yang sama via Vercel Dashboard → Project → Settings → Environment Variables.
# JANGAN commit file .env berisi nilai nyata.

# Public base URL API (dibundel ke browser via import.meta.env).
# Kosong = autentikasi nonaktif dan storefront memakai mock.
# Isi untuk mengaktifkan auth + request API nyata.
VITE_API_URL=http://localhost:8000/api/v1

# Pertahankan storefront di mock saat auth memakai API nyata.
# true = mock storefront. false/kosong = pakai API bila VITE_API_URL terisi;
# bila VITE_API_URL kosong, storefront tetap mock.
VITE_MOCK_STOREFRONT=true

# Cookie auth Sanctum membutuhkan host yang sama (localhost:3000 → localhost:8000).
# Jangan mencampur localhost dan 127.0.0.1.

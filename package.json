{
  "name": "delysa-florist",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo Delysa Florist e-commerce",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "concurrently -n web,api -c green,magenta \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "pnpm --filter client-web-delysa-florist dev",
    "dev:api": "node scripts/dev-api.mjs",
    "build": "pnpm -r --filter client-web-delysa-florist... build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "gen:types": "pnpm --filter @delysa/shared gen:types"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
